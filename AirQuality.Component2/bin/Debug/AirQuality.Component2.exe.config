<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <client>
            <endpoint name="MonitoringStationServiceEndpoint"
                      address="net.tcp://localhost:8080/AirQualityService"
                      binding="netTcpBinding"
                      contract="AirQuality.Common.Interfaces.IMonitoringStationService" />
        </client>
    </system.serviceModel>
</configuration>
