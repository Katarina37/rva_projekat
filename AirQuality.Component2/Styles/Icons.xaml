<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="IconTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="PrimaryIconTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource AccentTextDark}"/>
    </Style>

    <Style x:Key="SecondaryIconTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style x:Key="DangerIconTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="CyanIconTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
    </Style>

    <Style x:Key="GreenIconTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
    </Style>

    <Style x:Key="RedIconTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
    </Style>

    <sys:String x:Key="StationIcon">&#xE707;</sys:String>
    <sys:String x:Key="ReadingIcon">&#xE8FD;</sys:String>
    <sys:String x:Key="ChartIcon">&#xE9D2;</sys:String>
    <sys:String x:Key="SaveIcon">&#xE74E;</sys:String>
    <sys:String x:Key="LoadIcon">&#xE8E5;</sys:String>
    <sys:String x:Key="AddIcon">&#xE710;</sys:String>
    <sys:String x:Key="EditIcon">&#xE70F;</sys:String>
    <sys:String x:Key="DeleteIcon">&#xE74D;</sys:String>
    <sys:String x:Key="UndoIcon">&#xE7A7;</sys:String>
    <sys:String x:Key="RedoIcon">&#xE7A6;</sys:String>
    <sys:String x:Key="SearchIcon">&#xE721;</sys:String>
    <sys:String x:Key="CsvExportIcon">&#xEDE0;</sys:String>
    <sys:String x:Key="DownloadIcon">&#xE896;</sys:String>
    <sys:String x:Key="CalculateIcon">&#xE8EF;</sys:String>
    <sys:String x:Key="LiveIcon">&#xEC4A;</sys:String>
</ResourceDictionary>
