<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundPrimary" Color="#0B0B0D"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#151517"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#1F2023"/>
    <SolidColorBrush x:Key="PanelBackgroundLight" Color="#292A2E"/>
    <SolidColorBrush x:Key="BorderDark" Color="#333438"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#777777"/>
    <SolidColorBrush x:Key="AccentTextDark" Color="#0B0B0D"/>

    <SolidColorBrush x:Key="AccentGreen" Color="#39D353"/>
    <SolidColorBrush x:Key="AccentCyan" Color="#00A8B5"/>
    <SolidColorBrush x:Key="AccentRed" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F4D03F"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#FF8C32"/>

    <SolidColorBrush x:Key="StateGood" Color="#39D353"/>
    <SolidColorBrush x:Key="StateModerate" Color="#F4D03F"/>
    <SolidColorBrush x:Key="StateUnhealthy" Color="#FF8C32"/>
    <SolidColorBrush x:Key="StateHazardous" Color="#E53935"/>

    <SolidColorBrush x:Key="AccentGreenHover" Color="#4BE367"/>
    <SolidColorBrush x:Key="AccentGreenPressed" Color="#2FAA43"/>
    <SolidColorBrush x:Key="AccentCyanHover" Color="#10B8C5"/>
    <SolidColorBrush x:Key="AccentCyanPressed" Color="#007E89"/>
    <SolidColorBrush x:Key="AccentRedHover" Color="#F04B47"/>
    <SolidColorBrush x:Key="AccentRedPressed" Color="#B92D2A"/>
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#36383D"/>
    <SolidColorBrush x:Key="SecondaryButtonPressed" Color="#202125"/>
    <SolidColorBrush x:Key="InputBackground" Color="#18191C"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
</ResourceDictionary>
