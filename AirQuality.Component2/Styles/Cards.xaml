<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DashboardCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
    </Style>

    <Style x:Key="MetricCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="MinHeight" Value="124"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="6"/>
    </Style>

    <Style x:Key="ContentPanelStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
</ResourceDictionary>
