<Window x:Class="AirQuality.Component2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AirQuality.Component2.Views"
        mc:Ignorable="d"
        Title="Komponenta 2 - Statistika kvaliteta vazduha"
        Height="680" Width="1100"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DashboardWindowStyle}">
    <Grid Background="{StaticResource BackgroundPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="STATISTIKA KVALITETA VAZDUHA"
                               Style="{StaticResource DashboardTitleText}"/>
                    <TextBlock Text="Komponenta 2 / statistička obrada merenja"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <views:StatisticsView Grid.Row="1" Margin="18"/>
    </Grid>
</Window>
