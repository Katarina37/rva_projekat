<Window x:Class="AirQuality.Component1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AirQuality.Component1.Views"
        Title="Sistem za praćenje kvaliteta vazduha"
        Height="680" Width="1080"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DashboardWindowStyle}">
    <Grid Background="{StaticResource BackgroundPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="PRAĆENJE KVALITETA VAZDUHA"
                               Style="{StaticResource DashboardTitleText}"/>
                    <TextBlock Text="Sistem za praćenje kvaliteta vazduha"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <Button Name="BtnStations"
                        Click="BtnStations_Click"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CyanIconTextStyle}" Text="{StaticResource StationIcon}"/>
                        <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Stanice"/>
                    </StackPanel>
                </Button>
                <Button Name="BtnReadings"
                        Click="BtnReadings_Click"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OrangeIconTextStyle}" Text="{StaticResource ReadingIcon}"/>
                        <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Merenja"/>
                    </StackPanel>
                </Button>
                <Button Name="BtnCharts"
                        Click="BtnCharts_Click"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource YellowIconTextStyle}" Text="{StaticResource ChartIcon}"/>
                        <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Grafikoni"/>
                    </StackPanel>
                </Button>
                <Button Name="BtnSave"
                        Click="BtnSave_Click"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GreenIconTextStyle}" Text="{StaticResource SaveIcon}"/>
                        <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Sačuvaj"/>
                    </StackPanel>
                </Button>
                <Button Name="BtnLoad"
                        Click="BtnLoad_Click"
                        Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RedIconTextStyle}" Text="{StaticResource LoadIcon}"/>
                        <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Učitaj"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Name="MainContent" Margin="18"/>
    </Grid>
</Window>
