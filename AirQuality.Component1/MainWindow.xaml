<Window x:Class="AirQuality.Component1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AirQuality.Component1.Views"
        Title="Sistem za praćenje kvaliteta vazduha" 
        Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal"
            Background="#2C3E50" Margin="0,0,0,0">
            <Button Content="Stanice" Name="BtnStations"
            Click="BtnStations_Click"
            Foreground="White" Background="Transparent"
            BorderThickness="0" Padding="15,10"/>
            <Button Content="Mjerenja" Name="BtnReadings"
            Click="BtnReadings_Click"
            Foreground="White" Background="Transparent"
            BorderThickness="0" Padding="15,10"/>
            <Button Content="Grafikoni" Name="BtnCharts"
            Click="BtnCharts_Click"
            Foreground="White" Background="Transparent"
            BorderThickness="0" Padding="15,10"/>
            <Button Content="Sačuvaj" Name="BtnSave"
            Click="BtnSave_Click"
            Foreground="White" Background="Transparent"
            BorderThickness="0" Padding="15,10"/>
            <Button Content="Učitaj" Name="BtnLoad"
            Click="BtnLoad_Click"
            Foreground="White" Background="Transparent"
            BorderThickness="0" Padding="15,10"/>
        </StackPanel>

        <ContentControl Grid.Row="1" Name="MainContent"/>
    </Grid>
</Window>