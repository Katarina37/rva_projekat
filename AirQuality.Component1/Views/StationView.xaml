<UserControl x:Class="AirQuality.Component1.Views.StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AirQuality.Component1.ViewModels">

    <UserControl.DataContext>
        <vm:StationViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="MERNE STANICE"
                           Style="{StaticResource SectionTitleText}"/>
                <TextBlock Text="Pregled i upravljanje mernim stanicama"
                           Style="{StaticResource MutedText}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource ContentPanelStyle}"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource InputBackground}"
                        BorderBrush="{StaticResource BorderDark}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,0"
                        Width="320"
                        Height="38"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource IconTextStyle}"
                                   Text="{StaticResource SearchIcon}"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource TransparentBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 MinHeight="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Pretraži po nazivu, gradu ili četvrti"/>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding UndoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SecondaryIconTextStyle}" Text="{StaticResource UndoIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Poništi"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RedoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SecondaryIconTextStyle}" Text="{StaticResource RedoIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Ponovi"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PrimaryIconTextStyle}" Text="{StaticResource AddIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Dodaj"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EditCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SecondaryIconTextStyle}" Text="{StaticResource EditIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Izmeni"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DangerIconTextStyle}" Text="{StaticResource DeleteIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Obriši"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentPanelStyle}">
            <DataGrid ItemsSource="{Binding Stations}"
                      SelectedItem="{Binding SelectedStation}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="1.4*"/>
                    <DataGridTextColumn Header="Grad" Binding="{Binding City}" Width="1.1*"/>
                    <DataGridTextColumn Header="Četvrt" Binding="{Binding District}" Width="1.1*"/>
                    <DataGridTextColumn Header="Geografska širina" Binding="{Binding Latitude}" Width="1.2*"/>
                    <DataGridTextColumn Header="Geografska dužina" Binding="{Binding Longitude}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
