<UserControl x:Class="AirQuality.Component1.Views.StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AirQuality.Component1.ViewModels">

    <UserControl.DataContext>
        <vm:StationViewModel/>
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Grid.Row="0" Text="Mjerne stanice" FontSize="18" 
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Pretraga -->
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10" Padding="5"
                 Tag="Pretraži po nazivu, gradu ili četvrti..."/>

        <!-- Tabela stanica -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Stations}"
                  SelectedItem="{Binding SelectedStation}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Grad" Binding="{Binding City}" Width="120"/>
                <DataGridTextColumn Header="Četvrt" Binding="{Binding District}" Width="120"/>
                <DataGridTextColumn Header="Geografska širina" Binding="{Binding Latitude}" Width="130"/>
                <DataGridTextColumn Header="Geografska dužina" Binding="{Binding Longitude}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Dugmad -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
            HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="↩ Undo" Command="{Binding UndoCommand}" 
            Width="80" Margin="5,0"/>
            <Button Content="↪ Redo" Command="{Binding RedoCommand}" 
            Width="80" Margin="5,0"/>
            <Button Content="Dodaj" Command="{Binding AddCommand}" 
            Width="80" Margin="5,0"/>
            <Button Content="Izmijeni" Command="{Binding EditCommand}" 
            Width="80" Margin="5,0"/>
            <Button Content="Obriši" Command="{Binding DeleteCommand}" 
            Width="80" Margin="5,0"/>
        </StackPanel>
    </Grid>
</UserControl>