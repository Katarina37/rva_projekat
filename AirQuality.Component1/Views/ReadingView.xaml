<UserControl x:Class="AirQuality.Component1.Views.ReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AirQuality.Component1.ViewModels">
    <UserControl.DataContext>
        <vm:ReadingViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Grid.Row="0" Text="Mjerenja kvaliteta vazduha" FontSize="18"
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Pretraga -->
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10" Padding="5"
                 Tag="Pretraži po stanici, stanju, PM2.5..."/>

        <!-- Tabela mjerenja -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Readings}"
                  SelectedItem="{Binding SelectedReading}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stanica ID" Binding="{Binding StationId}" Width="220"/>
                <DataGridTextColumn Header="Datum i vrijeme" Binding="{Binding ReadingTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="PM2.5 (μg/m³)" Binding="{Binding PM25}" Width="120"/>
                <DataGridTextColumn Header="NO2 (μg/m³)" Binding="{Binding NO2Level}" Width="120"/>
                <DataGridTextColumn Header="Ozon (μg/m³)" Binding="{Binding OzoneLevel}" Width="120"/>
                <DataGridTextColumn Header="Stanje" Binding="{Binding State}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Dugmad -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Dodaj" Command="{Binding AddCommand}"
                    Width="80" Margin="5,0"/>
            <Button Content="Izmijeni" Command="{Binding EditCommand}"
                    Width="80" Margin="5,0"/>
            <Button Content="Obriši" Command="{Binding DeleteCommand}"
                    Width="80" Margin="5,0"/>
        </StackPanel>
    </Grid>
</UserControl>