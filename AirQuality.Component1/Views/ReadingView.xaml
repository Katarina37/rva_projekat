<UserControl x:Class="AirQuality.Component1.Views.ReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AirQuality.Common.Models;assembly=AirQuality.Common"
             xmlns:vm="clr-namespace:AirQuality.Component1.ViewModels">
    <UserControl.DataContext>
        <vm:ReadingViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="StateTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AppTextBlock}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:AirQualityState.Good}">
                    <Setter Property="Foreground" Value="{StaticResource StateGood}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:AirQualityState.Moderate}">
                    <Setter Property="Foreground" Value="{StaticResource StateModerate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:AirQualityState.Unhealthy}">
                    <Setter Property="Foreground" Value="{StaticResource StateUnhealthy}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:AirQualityState.Hazardous}">
                    <Setter Property="Foreground" Value="{StaticResource StateHazardous}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="MERENJA KVALITETA VAZDUHA"
                           Style="{StaticResource SectionTitleText}"/>
                <TextBlock Text="Pregled PM2.5, NO2, ozona i stanja kvaliteta vazduha"
                           Style="{StaticResource MutedText}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource ContentPanelStyle}"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource InputBackground}"
                        BorderBrush="{StaticResource BorderDark}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,0"
                        Width="320"
                        Height="38"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource IconTextStyle}"
                                   Text="{StaticResource SearchIcon}"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource TransparentBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 MinHeight="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Pretraga merenja"/>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding UndoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SecondaryIconTextStyle}" Text="{StaticResource UndoIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Poništi"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RedoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SecondaryIconTextStyle}" Text="{StaticResource RedoIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Ponovi"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PrimaryIconTextStyle}" Text="{StaticResource AddIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Dodaj"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EditCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SecondaryIconTextStyle}" Text="{StaticResource EditIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Izmeni"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DangerIconTextStyle}" Text="{StaticResource DeleteIcon}"/>
                            <TextBlock Style="{StaticResource ButtonTextBlockStyle}" Text="Obriši"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentPanelStyle}">
            <DataGrid ItemsSource="{Binding Readings}"
                      SelectedItem="{Binding SelectedReading}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Stanica ID"
                                        Binding="{Binding StationId}" Width="2.4*"/>
                    <DataGridTextColumn Header="Datum i vreme"
                                        Binding="{Binding ReadingTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="1.4*"/>
                    <DataGridTextColumn Header="PM2.5"
                                        Binding="{Binding PM25}" Width="0.8*"/>
                    <DataGridTextColumn Header="NO2"
                                        Binding="{Binding NO2Level}" Width="0.8*"/>
                    <DataGridTextColumn Header="Ozon"
                                        Binding="{Binding OzoneLevel}" Width="0.8*"/>
                    <DataGridTextColumn Header="Stanje"
                                        Binding="{Binding StateDisplay}"
                                        ElementStyle="{StaticResource StateTextStyle}"
                                        Width="1.1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
