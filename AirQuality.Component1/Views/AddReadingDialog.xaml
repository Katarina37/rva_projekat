<Window x:Class="AirQuality.Component1.Views.AddReadingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AirQuality.Common.Models;assembly=AirQuality.Common"
        Title="Dodaj mjerenje" Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stanica:" VerticalAlignment="Center" Margin="0,8"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Name="CmbStation"
                  DisplayMemberPath="Name" Margin="0,8" Padding="4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="PM2.5 (μg/m³):" VerticalAlignment="Center" Margin="0,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="TxtPM25" Margin="0,8" Padding="4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="NO2 (μg/m³):" VerticalAlignment="Center" Margin="0,8"/>
        <TextBox Grid.Row="2" Grid.Column="1" Name="TxtNO2" Margin="0,8" Padding="4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ozon (μg/m³):" VerticalAlignment="Center" Margin="0,8"/>
        <TextBox Grid.Row="3" Grid.Column="1" Name="TxtOzone" Margin="0,8" Padding="4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Stanje:" VerticalAlignment="Center" Margin="0,8"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Name="CmbState" Margin="0,8" Padding="4"/>

        <!-- Poruka greške -->
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Name="TxtError"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,8"/>

        <!-- Dugmad -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Potvrdi" Name="BtnConfirm" Click="BtnConfirm_Click"
                    Width="80" Margin="5,0"/>
            <Button Content="Otkaži" Name="BtnCancel" Click="BtnCancel_Click"
                    Width="80" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>