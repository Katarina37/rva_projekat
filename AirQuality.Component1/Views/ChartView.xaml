<UserControl x:Class="AirQuality.Component1.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AirQuality.Component1.ViewModels">
    <UserControl.DataContext>
        <vm:ChartViewModel/>
    </UserControl.DataContext>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Stanja mjerenja u realnom vremenu"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18"
                HorizontalAlignment="Stretch">
            <Grid MinHeight="300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding TotalReadings, StringFormat=Ukupno mjerenja: {0}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,22"/>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding StateBars}"
                              FlowDirection="LeftToRight"
                              Width="700"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="54" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="500"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="{Binding Color}"
                                            Width="13"
                                            Height="13"
                                            CornerRadius="2"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Grid.Column="1"
                                      Height="30"
                                      VerticalAlignment="Center">
                                    <Border Background="#E5EAF0"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <Border Background="{Binding Color}"
                                            Width="{Binding BarWidth}"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"/>
                                    <Border Width="2"
                                            Background="#64748B"
                                            HorizontalAlignment="Left"
                                            Margin="1,4,0,4"
                                            CornerRadius="1"/>
                                </Grid>

                                <Border Grid.Column="2"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Width="46"
                                        Height="30"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
